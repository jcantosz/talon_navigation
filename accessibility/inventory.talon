os: mac
-

show application numbers:
    user.accessibility_show_application_numbers()
refresh application numbers | refresh numbers:
    user.accessibility_refresh_application_numbers()
accessibility interfaces on:
    user.accessibility_set_interfaces(true, false)
accessibility interfaces force on:
    user.accessibility_set_interfaces(true, true)
accessibility interfaces off:
    user.accessibility_set_interfaces(false, false)
