{
  "tiles": true,
  "max_depth": 40,
  "scope": { "ancestor": { "classes": ["split-view-view", "visible"] } },
  "panes": [
    { "name": "title bar", "match": { "classes": ["titlebar-container"] } },
    { "name": "activity bar", "match": { "class_suffix": "view-bar-icon" } },
    { "name": "sidebar", "match": { "classes": ["composite", "viewlet"] } },
    { "name": "editor", "match": { "dom_id": "workbench.parts.editor" } },
    { "name": "panel", "match": { "classes": ["composite", "panel"] } },
    { "name": "auxiliary bar", "match": { "classes": ["composite", "auxiliarybar"] } },
    { "name": "status bar", "match": { "dom_id": "workbench.parts.statusbar" } }
  ]
}
